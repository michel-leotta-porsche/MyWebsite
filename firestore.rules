rules_version = '2';
// Bücher gehören ihrem Macher. Geteilt wird über einen Link mit Zufallsschlüssel (shares/{token}):
// wer den Schlüssel kennt, darf genau dieses eine Dokument lesen, aber keine Liste abfragen.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    // Meldungen bearbeiten und Links sperren; muss zu src/lib/admin.ts passen
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'michel.julian.leotta@gmail.com' && request.auth.token.email_verified == true;
    }

    match /books/{id} {
      allow read, update, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;

      // Zwischenstände: nur der Macher des Buchs
      match /versions/{v} {
        allow read, create, delete: if signedIn()
          && get(/databases/$(db)/documents/books/$(id)).data.owner == request.auth.uid;
      }
    }

    match /shares/{token} {
      allow get: if true;
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.owner == request.auth.uid
        && (resource == null || resource.data.owner == request.auth.uid);
      allow delete: if (signedIn() && resource.data.owner == request.auth.uid) || isAdmin();

      // Zettel und Eselsohren der Gäste: nur der Macher liest sie
      match /notes/{note} {
        allow create: if exists(/databases/$(db)/documents/shares/$(token))
          && request.resource.data.keys().hasOnly(['kind', 'text', 'no', 'x', 'y', 'from', 'at'])
          && request.resource.data.kind in ['note', 'ear']
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 280))
          && (!('from' in request.resource.data) || (request.resource.data.from is string && request.resource.data.from.size() <= 80))
          && (!('no' in request.resource.data) || request.resource.data.no is number)
          // Stelle eines angehefteten Zettels auf dem Foto, 0 bis 1
          && (!('x' in request.resource.data) || (request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 1))
          && (!('y' in request.resource.data) || (request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 1))
          && request.resource.data.at == request.time;
        allow read, delete: if (signedIn()
          && get(/databases/$(db)/documents/shares/$(token)).data.owner == request.auth.uid) || isAdmin();
      }
    }

    // Kano-Fragebogen: anonyme Antworten, Auswertung auf /qfd (nur für Angemeldete lesbar, Seite ist intern)
    match /kano/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['answers', 'camera', 'at'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 30
        && request.resource.data.at == request.time
        && (!('camera' in request.resource.data) || request.resource.data.camera in ['handy', 'kamera', 'beides']);
    }

    // Eigene Rezepte aus der Bildbearbeitung: nur ihr Macher
    match /users/{uid}/recipes/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && id.matches('own-[0-9a-z]{1,16}')
        && request.resource.data.keys().hasOnly(['id', 'name', 'txt', 'v', 'f'])
        && request.resource.data.keys().hasAll(['id', 'name', 'v'])
        && request.resource.data.id == id
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && (!('txt' in request.resource.data) || (request.resource.data.txt is string && request.resource.data.txt.size() <= 60))
        && validRecipe(request.resource.data.v)
        && (!('f' in request.resource.data) || validLookFine(request.resource.data.f));
    }

    // Rezeptwerte: dieselben Felder und Bereiche wie die Regler im Bearbeiten-Dialog
    function validRecipe(v) {
      return v is map
        && v.keys().hasOnly(['film', 'wbR', 'wbB', 'hl', 'sh', 'color', 'dr', 'cc', 'fxb', 'grain', 'gsize'])
        && v.keys().hasAll(['film', 'wbR', 'wbB', 'hl', 'sh', 'color', 'dr', 'cc', 'fxb', 'grain', 'gsize'])
        && (v.film == null || v.film in ['sommer', 'kreide', 'daemmerung', 'salz', 'kohle', 'messing'])
        && v.wbR is int && v.wbR >= -9 && v.wbR <= 9
        && v.wbB is int && v.wbB >= -9 && v.wbB <= 9
        && v.hl is number && v.hl >= -2 && v.hl <= 4
        && v.sh is number && v.sh >= -2 && v.sh <= 4
        && v.color is int && v.color >= -4 && v.color <= 4
        && v.dr in [100, 200, 400]
        && v.cc in [0, 1, 2] && v.fxb in [0, 1, 2] && v.grain in [0, 1, 2]
        && v.gsize in ['klein', 'groß'];
    }

    // Eigener Look: Feinschliff und Look mit Stärke, dieselben Bereiche wie die Regler
    function validLookFine(f) {
      return f is map
        && f.keys().hasOnly(['exposure', 'contrast', 'shadows', 'warmth', 'sat', 'look', 'amount'])
        && f.keys().hasAll(['exposure', 'contrast', 'shadows', 'warmth', 'sat', 'look', 'amount'])
        && f.exposure is number && f.exposure >= -1 && f.exposure <= 1
        && f.contrast is number && f.contrast >= -1 && f.contrast <= 1
        && f.shadows is number && f.shadows >= 0 && f.shadows <= 1
        && f.warmth is number && f.warmth >= -1 && f.warmth <= 1
        && f.sat is number && f.sat >= -1 && f.sat <= 1
        && (f.look == null || f.look in ['sommer', 'kreide', 'daemmerung', 'salz', 'kohle', 'messing'])
        && f.amount is number && f.amount >= 0 && f.amount <= 1;
    }

    // Meldungen zu geteilten Büchern (App Store 1.2): jeder darf melden, auch ohne Konto; lesen nur der Admin
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'owner', 'fromName', 'title', 'reason', 'text', 'reporter', 'at'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 64
        && request.resource.data.owner is string && request.resource.data.owner.size() <= 128
        && request.resource.data.reason in ['anstoessig', 'gewalt', 'belaestigung', 'rechte', 'anderes']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 80
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && (request.resource.data.reporter == null || (signedIn() && request.resource.data.reporter == request.auth.uid))
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // Eigene Angaben: wann den Nutzungsbedingungen zugestimmt
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Personen, deren Bücher ich nicht mehr sehen will
    match /users/{uid}/blocked/{sender} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Bücher, die jemand für mich hingelegt hat
    match /users/{uid}/inbox/{token} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
