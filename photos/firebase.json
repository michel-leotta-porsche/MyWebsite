{
  "hosting": {
    "public": "out",
    "predeploy": ["npm --prefix \"$PROJECT_DIR\" run export", "node \"$PROJECT_DIR/scripts/check-export.mjs\""],
    "cleanUrls": true,
    "redirects": [{ "source": "/tisch", "destination": "/zimmer", "type": 301 }],
    "ignore": [
      "firebase.json",
      "**/.*",
      "photos/**"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/textures/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
