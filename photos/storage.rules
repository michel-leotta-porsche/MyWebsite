rules_version = '2';
// Fotos liegen unter u/{uid}/…, nur der Macher schreibt und liest per SDK.
// Gäste sehen sie über die Download-Links mit Zufallsschlüssel, die im geteilten Buch stehen.
service firebase.storage {
  match /b/{bucket}/o {
    match /u/{uid}/{rest=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      // Papierkorb leeren: der Macher löscht seine Fotos
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
